{
  "name": "supabase-declarative-schema-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "declarative-schema": "node --experimental-strip-types declarative-schema/run.mts",
    "declarative-schema:ddl": "npm run declarative-schema -- --plane=ddl",
    "declarative-schema:behavior": "npm run declarative-schema -- --plane=service",
    "declarative-schema:functions": "npm run declarative-schema -- --plane=functions",
    "declarative-schema:config": "npm run declarative-schema -- --plane=config",
    "declarative-schema:remote": "npm run declarative-schema -- --plane=remote --remote",
    "declarative-schema:unit": "node --experimental-strip-types --test declarative-schema/runner/*.test.mts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "^26.2.0",
    "listr2": "^9.0.5",
    "supabase": "https://pkg.pr.new/supabase/cli/supabase@509f6a9d23e83d2e88d459b746c522752c7c49e2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
