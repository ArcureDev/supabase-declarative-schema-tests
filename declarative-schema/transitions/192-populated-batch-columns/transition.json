{
  "expectation": "applicable-transition",
  "declarativeFile": "populated-batch-columns.sql",
  "description": "add array and JSON columns with defaults to populated rows",
  "requiredMigrationPatterns": [
    {
      "description": "adds the tags column",
      "pattern": "\\balter\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*batch_column_guard\\b[\\s\\S]*\\badd\\s+(?:column\\s+)?tags\\b"
    },
    {
      "description": "adds the metadata column",
      "pattern": "\\balter\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*batch_column_guard\\b[\\s\\S]*\\badd\\s+(?:column\\s+)?metadata\\b"
    }
  ],
  "forbiddenMigrationPatterns": [
    {
      "description": "does not alter or drop the transition anchor",
      "pattern": "\\b(?:alter|drop)\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*transition_anchor\\b"
    },
    {
      "description": "does not recreate the populated table",
      "pattern": "\\b(?:drop\\s+table|create\\s+table)\\s+public\\s*\\.\\s*batch_column_guard\\b"
    },
    {
      "description": "does not drop the existing payload column",
      "pattern": "\\bdrop\\s+(?:column\\s+)?payload\\b"
    }
  ]
}
