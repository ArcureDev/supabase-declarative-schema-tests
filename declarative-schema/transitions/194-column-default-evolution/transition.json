{
  "expectation": "applicable-transition",
  "declarativeFile": "column-default-evolution.sql",
  "description": "change a default while preserving existing defaulted and explicit values",
  "requiredMigrationPatterns": [
    {
      "description": "sets the new status default",
      "pattern": "\\balter\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*default_guard\\b[\\s\\S]*\\balter\\s+(?:column\\s+)?status\\b[\\s\\S]*\\bset\\s+default\\b"
    }
  ],
  "forbiddenMigrationPatterns": [
    {
      "description": "does not alter or drop the transition anchor",
      "pattern": "\\b(?:alter|drop)\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*transition_anchor\\b"
    },
    {
      "description": "does not recreate the populated table",
      "pattern": "\\b(?:drop\\s+table|create\\s+table)\\s+public\\s*\\.\\s*default_guard\\b"
    },
    {
      "description": "does not drop status",
      "pattern": "\\bdrop\\s+(?:column\\s+)?status\\b"
    }
  ]
}
