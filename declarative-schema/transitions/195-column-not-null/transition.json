{
  "expectation": "applicable-transition",
  "declarativeFile": "column-not-null.sql",
  "description": "add not null when all populated values are valid",
  "requiredMigrationPatterns": [
    {
      "description": "sets note not null",
      "pattern": "\\balter\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*not_null_guard\\b[\\s\\S]*\\balter\\s+(?:column\\s+)?note\\b[\\s\\S]*\\bset\\s+not\\s+null\\b"
    }
  ],
  "forbiddenMigrationPatterns": [
    {
      "description": "does not alter or drop the transition anchor",
      "pattern": "\\b(?:alter|drop)\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*transition_anchor\\b"
    },
    {
      "description": "does not recreate the populated table",
      "pattern": "\\b(?:drop\\s+table|create\\s+table)\\s+public\\s*\\.\\s*not_null_guard\\b"
    },
    {
      "description": "does not drop note",
      "pattern": "\\bdrop\\s+(?:column\\s+)?note\\b"
    }
  ]
}
