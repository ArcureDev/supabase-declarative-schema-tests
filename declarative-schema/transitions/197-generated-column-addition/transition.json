{
  "expectation": "applicable-transition",
  "declarativeFile": "generated-column-addition.sql",
  "description": "add a stored generated column to populated data",
  "requiredMigrationPatterns": [
    {
      "description": "adds the stored generated total column",
      "pattern": "\\balter\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*generated_guard\\b[\\s\\S]*\\badd\\s+(?:column\\s+)?total\\b[\\s\\S]*\\bgenerated\\s+always\\s+as\\b"
    }
  ],
  "forbiddenMigrationPatterns": [
    {
      "description": "does not alter or drop the transition anchor",
      "pattern": "\\b(?:alter|drop)\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*transition_anchor\\b"
    },
    {
      "description": "does not recreate the populated table",
      "pattern": "\\b(?:drop\\s+table|create\\s+table)\\s+public\\s*\\.\\s*generated_guard\\b"
    },
    {
      "description": "does not drop generated-column inputs",
      "pattern": "\\bdrop\\s+(?:column\\s+)?(?:quantity|unit_price)\\b"
    }
  ]
}
