{
  "expectation": "applicable-transition",
  "declarativeFile": "managed-schema-boundary.sql",
  "description": "evolve an application table while preserving managed relations, ACLs, and publication identity",
  "requiredMigrationPatterns": [
    {
      "description": "add only the application column",
      "pattern": "\\balter\\s+table\\s+public\\.boundary_app_225\\s+add\\s+(?:column\\s+)?note\\b"
    }
  ],
  "forbiddenMigrationPatterns": [
    {
      "description": "do not emit managed-schema DDL",
      "pattern": "\\b(?:create|alter|drop|comment|grant|revoke)\\b[\\s\\S]{0,160}\\b(?:auth|storage|realtime|extensions|vault|net|cron|pgmq|pgsodium|graphql|supabase_migrations)\\s*\\."
    },
    {
      "description": "do not create, alter, or drop managed schemas",
      "pattern": "\\b(?:create|alter|drop)\\s+schema\\s+(?:if\\s+(?:not\\s+)?exists\\s+)?(?:auth|storage|realtime|extensions|vault|net|cron|pgmq|pgsodium|graphql|supabase_migrations)\\b"
    },
    {
      "description": "do not drop application state",
      "pattern": "\\bdrop\\s+(?:table|column)\\b"
    },
    {
      "description": "do not recreate preserved application tables",
      "pattern": "\\bcreate\\s+table\\s+public\\.(?:managed_probe_225|boundary_app_225)\\b"
    },
    {
      "description": "do not change managed object ownership or ACLs",
      "pattern": "\\b(?:alter\\s+(?:table|publication)\\b[\\s\\S]{0,100}\\bowner|(?:grant|revoke)\\b[\\s\\S]{0,160}\\b(?:auth|storage|realtime)\\.)"
    }
  ]
}
