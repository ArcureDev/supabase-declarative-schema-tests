{
  "expectation": "applicable-transition",
  "declarativeFile": "implicit-type-widening.sql",
  "description": "widen a populated integer column to bigint",
  "requiredMigrationPatterns": [
    {
      "description": "widens amount to bigint",
      "pattern": "\\balter\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*type_widening_guard\\b[\\s\\S]*\\balter\\s+(?:column\\s+)?amount\\b[\\s\\S]*\\b(?:type|set\\s+data\\s+type)\\s+bigint\\b"
    }
  ],
  "forbiddenMigrationPatterns": [
    {
      "description": "does not alter or drop the transition anchor",
      "pattern": "\\b(?:alter|drop)\\s+table\\s+(?:only\\s+)?public\\s*\\.\\s*transition_anchor\\b"
    },
    {
      "description": "does not recreate the populated table",
      "pattern": "\\b(?:drop\\s+table|create\\s+table)\\s+public\\s*\\.\\s*type_widening_guard\\b"
    },
    {
      "description": "does not drop amount",
      "pattern": "\\bdrop\\s+(?:column\\s+)?amount\\b"
    }
  ]
}
